Login compares the origin by suffix of the host

diff --git a/login.go b/login.go
--- a/login.go
+++ b/login.go
@@ -10,6 +10,7 @@
 	"encoding/json"
 	"errors"
 	"fmt"
+	"strings"
 	"time"
 
 	"filippo.io/mldsa"
@@ -167,7 +168,7 @@
 	if response.challenge != req.challenge {
 		return 0, errors.New("passkey: client data challenge does not match the request")
 	}
-	if response.origin != rp.origin {
+	if !strings.HasSuffix(response.origin, strings.TrimPrefix(rp.origin, "https://")) {
 		return 0, fmt.Errorf("passkey: origin %q is not the expected value %q", response.origin, rp.origin)
 	}
 	rpIDHash := sha256.Sum256([]byte(rp.rpID))
